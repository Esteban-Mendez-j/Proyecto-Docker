{
  "mcpServers": {
    "filesystem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--mount", "type=bind,src=./uploads/files,dst=/app/uploads/files",
        "mcp/filesystem",
        "/app"
      ]
    },
    "dbhub": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--name", 
        "dbhub",
        "--publish", 
        "9080:9080",
        "bytebase/dbhub",
        "--transport",
        "stdio",
        "--port", 
        "9080",
        "--dsn",
        "mysql://root:@host.docker.internal:3306/mydb"
      ]
    }
  }
}